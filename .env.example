# 이 파일은 실행 설정의 형식만 보여주는 예시입니다.
# 실제 대상 사이트 URL, 경로, 카테고리 ID는 .env에만 작성하고 커밋하지 마세요.

# 공개 정책을 확인한 대상의 기본 URL과 목록 경로로 교체합니다.
TARGET_URL=https://example.com
TARGET_PATH=/public-list

# 일반화된 예시 카테고리 ID
TARGET_CATEGORY_IDS=100,200,300

# 전체 목표 행 수와 카테고리별 수집 목표 행 수
TARGET_ROWS=100
TARGET_CATEGORY_ROWS=20

# 페이지당 표시할 항목 수
VIEW_ROWS_COUNT=25

# 정상 요청 사이의 최소·최대 대기 시간(초)
MINIMUM_SLEEP=2
MAXIMUM_SLEEP=5

# 로컬 수집 결과와 체크포인트 경로
LOADING_PATH=./data/books.csv
CHECKPOINT_PATH=./state/checkpoint.json
